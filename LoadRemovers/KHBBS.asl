start
{
    if (current.char_select_confirm_1 == 2 && old.char_select_confirm_1 == 1 && current.char_select_confirm_2 == 192) {
        vars.character_select_load = true;
        vars.completed_splits = new HashSet<string>();
        return true;
    }
}

split
{    
    var output_catch = "";

    var terraConfirm = settings["terra_base"] && current.character == 2;
    var venConfirm = settings["ven_base"] && current.character == 0;
    var aquaConfirm = settings["aqua_base"] && current.character == 1;
    var world_map = current.world == 17;

    if (current.world == 1 && current.room == 13 && current.char_select_confirm_1 == 2 && old.char_select_confirm_1 == 1 && current.char_select_confirm_2 == 192) {
        return settings["character_confirm"];
        }

    var fight_complete = current.state_1 != 2 && old.state_1 == 2 && current.state_2 != 128;
    if (fight_complete) {
        if (terraConfirm) {
             if (current.world == 1 && current.room == 2 && current.flag3 == 59) {
                return settings["terra_orbs"];
            }
            if (current.world == 1 && current.room == 1 && current.flag3 == 60) {
                return settings["eraqus"];
            }
            if (current.world == 1 && current.room == 16 && current.flag3 == 61) {
                return settings["terra_mf"];
            }
            if (current.world == 2 && current.room == 7 && current.flag3 == 51) {
                return settings["dw_ff"];
            }
            if (current.world == 2 && current.room == 9 && current.flag3 == 52) {
                return settings["terra_mirror"];
            }
            if (current.world == 3 && current.room == 6 && current.flag3 == 51) {
                return settings["cod_ff"];
            }
            if (current.world == 3 && current.room == 10 && current.flag3 == 53) {
               return settings["cinderella"];
            }
            if (current.world == 3 && current.room == 9 && current.flag3 == 54) {
                return settings["sm"];
            }
            if (current.world == 4 && current.room == 7 && current.flag3 == 52) {
                return settings["ed_ff"];
            }
            if (current.world == 4 && current.room == 12 && current.flag3 == 58) {
                return settings["ed_wm"];
            }
            if (current.world == 6 && current.room == 3 && current.flag3 == 53) {
                return settings["terra_rg_ff"];
            }
            if (current.world == 6 && current.room == 6 && current.flag3 == 54) {
                return settings["terra_rg_ta"];
            }
            if (current.world == 6 && current.room == 11 && current.flag3 == 55) {
                return settings["rg_braig"];
            }
            if (current.world == 8 && current.room == 5 && current.flag3 == 59) {
                return settings["terra_oc_ff"];
            }
            if (current.world == 8 && current.room == 4 && current.flag3 == 61) {
                return settings["terra_zack1"];
            }
            if (current.world == 8 && current.room == 4 && current.flag3 == 62) {
                return settings["terra_zack2"];
            }
            if (current.world == 9 && current.room == 1 && current.flag3 == 52) {
                return settings["terra_tpb_ff"];
            }
            if (current.world == 9 && current.room == 6 && current.flag3 == 53) {
                return settings["ex221"];
            }
            if (current.world == 11 && current.room == 11 && current.flag3 == 53) {
                return settings["terra_nl_ff"];
            }
            if (current.world == 11 && current.room == 13 && current.flag3 == 54) {
                return settings["pan"];
            }
            if (current.world == 11 && current.room == 13 && current.flag3 == 55) {
                return settings["tjs_swarm"];
            }
            if (current.world == 13 && current.room == 10 && current.flag3 == 56) {
                return settings["terra_vanitas"];
            }
            if (current.world == 13 && current.room == 10 && current.flag3 == 57) {
                return settings["xehanort"];
            }
            if (current.world == 13 && current.room == 11 && current.flag3 == 58) {
                return settings["terranort"];
            }
            if (current.world == 13 && current.room == 56 && current.flag3 == 87) {
                return settings["terra_remnant"];
            }
        }
        if (venConfirm) {
            if (current.world == 1 && current.room == 2 && current.flag3 == 68) {
                return settings["ven_orbs"];
            }
            if (current.world == 1 && current.room == 16 && current.flag3 == 69) {
                return settings["ven_mf"];
            }
            if (current.world == 2 && current.room == 8 && current.flag3 == 56 && current.state_2 == 192) {
                return settings["sw_escort"];
            }
            if (current.world == 2 && current.room == 8 && current.flag3 == 57) {
                return settings["mt"];
            }
            if (current.world == 3 && current.room == 13 && current.flag3 == 56) {
                return settings["lucifer"];
            }
            if (current.world == 4 && current.room == 3 && current.flag3 == 51) {
                return settings["ven_goons"];
            }
            if (current.world == 4 && current.room == 3 && current.flag3 == 54) {
                return settings["ven_maleficent"];
            }
            if (current.world == 6 && current.room == 6 && current.flag3 == 62) {
                return settings["ven_rg_ta"];
            }
            if (current.world == 6 && current.room == 3 && current.flag3 == 61) {
                return settings["ven_rg_ff"];
            }
            if (current.world == 8 && current.room == 5 && current.flag3 == 52) {
                return settings["ven_oc_ff"];
            }
            if (current.world == 8 && current.room == 5 && current.flag3 == 55) {
                return settings["vjs_swarm"];
            }
            if (current.world == 8 && current.room == 5 && current.flag3 == 55) {
                return settings["vjs_swarm"];
            }
            if (current.world == 9 && current.room == 12 && current.flag3 == 59) {
                if (vars.completed_splits.TryGetValue("ven_ds_ff_room_1", out output_catch)) {
                    return vars.completed_splits.Add("ven_ds_ff") && settings["ven_ds_ff"];
                } else {
                    vars.completed_splits.Add("ven_ds_ff_room_1");
                }
            }
            if (current.world == 9 && current.room == 8 && current.flag3 == 60) {
                return settings["meta2"];
            }
            if (current.world == 11 && current.room == 8 && current.flag3 == 51) {
                return settings["ven_nl_ff"];
            }
            if (current.world == 11 && current.room == 1 && current.flag3 == 52) {
                return settings["hook"];
            }
            if (current.world == 13 && current.room == 1 && current.flag3 == 52) {
                return settings["ven_van1"];
            }
            if (current.world == 13 && current.room == 12 && current.flag3 == 62) {
                return settings["ven_van2"];
            }
            if (current.world == 13 && current.room == 51 && current.flag3 == 63) {
                return settings["ven_van3"];
            }
            if (current.world == 13 && current.room == 56 && current.flag3 == 86) {
                return settings["ven_remnant"];
            }
        }
        if (aquaConfirm) {
            if (current.world == 1 && current.room == 2 && current.flag3 == 75) {
                return settings["aqua_orbs"];
            }
            if (current.world == 1 && current.room == 16 && current.flag3 == 76) {
                return settings["aqua_mf"];
            }
            if (current.world == 2 && current.room == 9 && current.flag3 == 59) {
                return settings["aqua_mirror"];
            }
            if (current.world == 3 && current.room == 3 && current.flag3 == 60) {
                return settings["jaq"];
            }
            if (current.world == 3 && current.room == 6 && current.flag3 == 59) {
                return settings["cc"];
            }
            if (current.world == 4 && current.room == 17 && current.flag3 == 53) {
                return settings["aqua_goons"];
            }
            if (current.world == 4 && current.room == 2 && current.flag3 == 56) {
                return settings["gates"];
            }
            if (current.world == 4 && current.room == 10 && current.flag3 == 57) {
                return settings["dragon_mal"];
            }
            if (current.world == 6 && current.room == 10 && current.flag3 == 68) {
                return settings["mickey_ff"];
            }
            if (current.world == 6 && current.room == 6 && current.flag3 == 69) {
                return settings["aqua_rg_ta"];
            }
            if (current.world == 6 && current.room == 3 && current.flag3 == 70) {
                return settings["rg_vanitas"];
            }
            if (current.world == 6 && current.room == 13 && current.flag3 == 71) {
                return settings["final_terranort1"];
            }
            if (current.world == 6 && current.room == 14 && current.flag3 == 72) {
                return settings["final_terranort2"];
            }
            if (current.world == 7 && current.room == 22 && current.flag3 == 80) {
                return settings["rod_ff3"];
            }
            if (current.world == 7 && current.room == 23 && current.flag3 == 78) {
                return settings["dark_hide"];
            }
            if (current.world == 8 && current.room == 1 && current.flag3 == 54) {
                return settings["aqua_oc_ff"];
            }
            if (current.world == 8 && current.room == 4 && current.flag3 == 57) {
                return settings["aqua_zack"];
            }
            if (current.world == 8 && current.room == 6 && current.flag3 == 68) {
                return settings["hades"];
            }
            if (current.world == 9 && current.room == 3 && current.flag3 == 55) {
                return settings["ds_dt_ff"];
            }
            if (current.world == 9 && current.room == 1 && current.flag3 == 64) {
                return settings["aqua_tpb_ff"];
            }
            if (current.world == 9 && current.room == 9 && current.flag3 == 57) {
                return settings["gantu"];
            }
            if (current.world == 11 && current.room == 8 && current.flag3 == 56) {
                return settings["nl_vanitas"];
            }
            if (current.world == 13 && current.room == 12 && current.flag3 == 60) {
                return settings["kg_braig"];
            }
            if (current.world == 13 && current.room == 12 && current.flag3 == 61) {
                return settings["ventus_vanitas"];
            }
            if (current.world == 13 && current.room == 56 && current.flag3 == 88) {
                return settings["aqua_remnant"];
            }
            if (current.world == 15 && current.room == 20 && current.flag2 == 24) {
                return settings["aqua_eraqus"];
            }
        }
    } else if (world_map) {
        if (aquaConfirm) {
            if (old.world == 1 && current.tlod_chests == 30) {
                return (settings["aqua_tlod1"]);
            }
            if (old.world == 2 && current.dw_chests_1 == 65456 && current.dw_chests_2 == 223 && current.dw_mission_score > 7199) {
                return (settings["aqua_dw2"]);
            }
            if (old.world == 3 && current.cod_chests == 989 && current.cod_mission_score > 29) {
                return (settings["aqua_cod2"]);
            }
            if (old.world == 4 && current.ed_chests_1 == 65520 && current.ed_chests_2 == 3 && current.ed_mission_score > 29) {
                return (settings["aqua_ed2"]);
            }
            if (old.world == 6 && current.rg_chests_1 == 65520 && current.rg_chests_2 == 15 && current.rg_mission_score < 3600) {
                return (settings["aqua_rg2"]);
            }
            if (old.world == 8 && current.urns_score_revisit > 0 && current.oc_chests == 15 && current.oc_mission_score < 1800 && current.oc_mission_score > 0) {
                return (settings["aqua_oc2"]);
            }
            if (old.world == 9 && current.ds_chests_1 == 16368 && current.ds_chests_2 == 240 && current.ds_mission_score > 89) {
                return (settings["aqua_ds2"]);
            }
            if (old.world == 12 && current.dt_chests_1 > 63983 && current.dt_chests_2 == 127 && current.dt_mission_score > 39) {
                return (settings["aqua_dt2"]);
            }
            if (old.world == 11 && current.nl_chests == 127 && current.nl_mission_score > 69) {
                return (settings["aqua_nl2"]);
            }
            if (old.world == 13 && old.room == 7 && current.kg_chests == 127 && current.kg_mission_score > 349) {
                return (settings["aqua_kg2"]);
            }
        }
    }

    if (current.world == 6 && current.room == 6 && old.room == 6) {
        if (venConfirm) {
            return vars.completed_splits.Add("vrg_grind_meld") && settings["vrg_grind_meld"];
        } else if (terraConfirm) {
            return vars.completed_splits.Add("get_to_trinity") && settings["get_to_trinity"];            
        }
    }
    if (aquaConfirm) {
        if (current.world == 2 && current.dw_mission_score > 7199 && old.dw_mission_score < 7200) {
            return (settings["aqua_dw_mission"]);
        }
        if (current.world == 3 && current.cod_mission_score > 29 && old.cod_mission_score < 30) {
            return (settings["aqua_cod_mission"]);
        }
        if (current.world == 4 && current.ed_mission_score > 29 && old.ed_mission_score < 30) {
            return (settings["aqua_ed_mission"]);
        }
        if (current.world == 6 && current.room == 10 && old.room == 9) {
            return vars.completed_splits.Add("aqua_abound") && settings["aqua_abound"];
        }
        if (current.world == 6 && current.rg_mission_score > 0 && current.rg_mission_score < 3600 && old.rg_mission_score == 0) {
            return (settings["aqua_rg_mission"]);
        }
        if (current.world == 7 && current.room == 21 && old.room == 20) {
            return (settings["rod_mz"]);
        }
        if (current.world == 7 && current.room == 22 && old.room == 21 && current.rod_uz_state == 0) {
            return (settings["rod_lz"]);
        }
        if (current.world == 7 && current.room == 23 && old.room == 22) {
            return (settings["rod_uz"]);
        }
        if (current.world == 8 && current.room == 4 && current.flag2 == 9 && current.max_hp > old.max_hp) {
            return (settings["aqua_tournament"] && aquaConfirm);
        }
        if (current.world == 8 && current.oc_mission_score > 0 && current.oc_mission_score < 1800 && old.oc_mission_score == 0) {
            return (settings["aqua_oc_mission"]);
        }
        if (current.world == 9 && current.room == 10 && current.state_1 == 1 && old.state_1 == 7 && current.state_2 == 64) {
            return settings["ds_exterior_ff"];
        }
        if (current.world == 9 && current.ds_mission_score > 89 && old.ds_mission_score < 90) {
            return (settings["aqua_ds_mission"]);
        }
        if (current.world == 11 && current.nl_mission_score > 69 && old.nl_mission_score < 70) {
            return (settings["aqua_nl_mission"]);
        }
        if (current.world == 12) {
            var score = vars.watchers["fruit_ball_score"];
            score.Update(game);
            if (score.Current > 0 && score.Old == 0) {
                return settings["fruitball"];
            }
        }
        if (current.world == 12 && current.dt_mission_score > 39 && old.dt_mission_score < 40) {
            return (settings["aqua_dt_mission"]);
        }
        if (current.world == 13 && current.kg_mission_score > 349 && old.kg_mission_score < 350) {
            return (settings["aqua_kg_mission"]);
        }
        // breaks if you go out of CoD more than once before finishing grind but after getting to mickey in RG
        if (current.world == 17 && old.world == 3) {
            if (vars.completed_splits.TryGetValue("aqua_abound", out output_catch)) {
                if (vars.completed_splits.TryGetValue("aqua_cod_shop", out output_catch)) {
                    return vars.completed_splits.Add("aqua_cod_grind") && settings["aqua_cod_grind"];
                } else {
                    vars.completed_splits.Add("aqua_cod_shop");
                }
            }
        }
    }

    if (terraConfirm) {
        if (current.world == 12) {
            var rr_complete = vars.watchers["rumble_racing_complete"];
            rr_complete.Update(game);
            if (rr_complete.Current == 1 && rr_complete.Old == 0) {
                return settings["rr"];
            }
        }
        if (current.world == 9 && current.room == 13 && current.state_1 == 1 && old.state_1 == 7 && current.state_2 == 64) {
            return settings["ds_ambush"];
        }
        if (current.world == 6 && current.room == 11) {
            return vars.completed_splits.Add("trg_grind_meld") && settings["trg_grind_meld"];
        }
        if (current.world == 8 && current.room == 4 && current.flag2 == 9 && current.max_hp > old.max_hp) {
            return (settings["terra_tournament"]);
        }
    }

    if (venConfirm) {
        // only find 6 dwarves for values of 1/2/4/8/16/32
        if (current.dwarf_count == 63 && old.dwarf_count < 63) {
            return settings["dwarves"];
        } 
        if (current.world == 3 && current.room == 1 && old.room == 3) {
            return settings["dress"];
        }
        // will need updates if route changes
        if (current.world == 17 && old.world == 6) {
            if (!vars.completed_splits.TryGetValue("ven_abound", out output_catch)) {
                return vars.completed_splits.Add("ven_abound") && settings["ven_abound"];
            } else {
                return vars.completed_splits.Add("leave_rg") && settings["leave_rg"];
            }
        }
        if (current.world == 17 && old.world == 3 && vars.completed_splits.TryGetValue("ven_abound", out output_catch)) {
            return vars.completed_splits.Add("cod_grind_2") && settings["cod_grind_2"];
        }
        if (current.world == 12) {
            var icb_score = vars.watchers["ice_cream_beat_score"];
            icb_score.Update(game);
            if (icb_score.Current > 999 && icb_score.Old < 1000) {
                return settings["icb"];
            }
        }
        if (current.world == 8 && current.room == 3 && current.urns_score > 0 && old.urns_score == 0) {
            return settings["pots"];
        }
        if (current.world == 9 && current.room == 13 && current.state_2 == 64 && old.state_2 == 0) {
            return settings["meta1"];
        }
    }
}

exit
{
    vars.character_select_load = false;
    timer.IsGameTimePaused = true;  
}

init
{    
    // game base address
    var gb = modules.First().BaseAddress;
    int epic_gl = memory.ReadValue<byte>(gb + 0x726364);
    int epic_jp = memory.ReadValue<byte>(gb + 0x726344);
    int steam_gl = memory.ReadValue<byte>(gb + 0x726464);
    int steam_jp = memory.ReadValue<byte>(gb + 0x7253E4);
    if (epic_gl == 106 || epic_jp == 106) {
        if (epic_gl == 106) {
            version = "EG Global";
        } else {
            version = "EG JP";
        }
        vars.watchers = new Dictionary<string, MemoryWatcher>{
            { "fruit_ball_score", new MemoryWatcher<byte>(gb + 0x10FB07D4) },
            { "ice_cream_beat_score", new MemoryWatcher<ushort>(gb + 0x10FB081C) },
            { "rumble_racing_complete", new MemoryWatcher<byte>(gb + 0x10FB2CBC) },
        };
    } else if (steam_gl == 106 || steam_jp == 106) {
        int offset = 0x0;
        if (steam_gl == 106) {
            version = "Steam Global";
        } else {
            version = "Steam JP";
            offset = 0x1000;
        }
        vars.watchers = new Dictionary<string, MemoryWatcher>{
            { "fruit_ball_score", new MemoryWatcher<byte>(gb + 0x10FB00D4 - offset) },
            { "ice_cream_beat_score", new MemoryWatcher<ushort>(gb + 0x10FB011C - offset) },
            { "rumble_racing_complete", new MemoryWatcher<byte>(gb + 0x10FB25BC - offset) },
        };
    }
    vars.completed_splits = new HashSet<string>();

    timer.IsGameTimePaused = false;
}

reset
{
    return current.reset > 0 && old.reset == 0 && !settings["extended"];
}

update
{
    if (vars.character_select_load && current.text_box == 2 && old.text_box == 1) {
        vars.character_select_load = false;
    }
}

isLoading
{
    return !vars.character_select_load && ((current.world == 17 && current.state_2 > 1 && current.state_2 < 4) || (current.world == 1 && current.room == 13 && current.state_2 > 1 && current.state_2 < 3) || (current.world == 1 && current.room != 13 && current.state_2 > 1 && current.state_2 < 5) || (current.world > 1 && current.world < 5 && current.state_2 > 1 && current.state_2 < 5) || (current.world == 5 && current.flag3 == 56 && current.state_2 == 4) || (current.world == 5 && current.flag3 != 56 && current.state_2 > 1 && current.state_2 < 5) || (current.world == 6 && current.state_2 > 1 && current.state_2 < 5) || (current.world == 7 && current.flag3 == 57 && current.state_2 == 4) || (current.world == 7 && current.flag3 != 57 && current.state_2 > 1 && current.state_2 < 5) || (current.world > 7 && current.world < 10 && current.state_2 > 1 && current.state_2 < 5) || (current.world == 10 && current.flag3 == 60 && current.state_2 == 4) || (current.world == 10 && current.flag3 != 60 && current.state_2 > 1 && current.state_2 < 5) || (current.world > 10 && current.world < 13 && current.state_2 > 1 && current.state_2 < 5) || (current.world == 13 && current.flag3 == 67 && (current.state_2 == 2 || current.state_2 == 4)) || (current.world == 13 && current.flag3 != 67 && current.state_2 > 1 && current.state_2 < 5) || (current.world == 15 && current.state_2 > 1 && current.state_2 < 5));
}
